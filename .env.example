CONTEXT7_API_KEY=ctx7sk-9528dc4d-bfa7-4ce0-93f6-8ea5b5526e07

# --- Docker stack (docker-compose.yml) ---
# Postgres
POSTGRES_USER=care
POSTGRES_PASSWORD=care_password
POSTGRES_DB=care_orchestration
POSTGRES_PORT=5432

# pgAdmin (http://localhost:5050)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Backend / frontend published ports
BACKEND_PORT=8000
FRONTEND_PORT=5500
APP_ENV=dev

# Backend Postgres connection (set automatically inside Docker; override to run
# the backend on the host against a local/Dockerized Postgres). Leave unset to
# use the built-in in-memory store.
# DATABASE_URL=postgresql://care:care_password@localhost:5432/care_orchestration
